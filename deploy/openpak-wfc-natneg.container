[Unit]
Description=OpenPak WFC natneg
After=openpak-postgres.service

[Container]
ContainerName=openpak-wfc-natneg
Image=ghcr.io/openpak/wfc-natneg:latest
Network=openpak.network
EnvironmentFile=%h/openpak/deploy/wfc-full/wfc-natneg.env
Volume=%h/openpak/deploy/wfc-split/token.key:/keys/wfc-token.key:ro,U
PublishPort=0.0.0.0:27901:27901/udp

[Service]
Restart=always

[Install]
WantedBy=default.target
